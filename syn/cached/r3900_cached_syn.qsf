# Synthesis-only project for the core with its caches, to get area, block
# RAM and Fmax before it is wired to a memory controller.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY r3900_cached
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cpu/r3900.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cpu/r3900_cache.sv
set_global_assignment -name SDC_FILE r3900_cached_syn.sdc

# Everything but clock and reset is virtual: this measures area and
# Fmax, it does not bond the core to a package.
set_instance_assignment -name VIRTUAL_PIN ON -to imem_addr[0]
set_instance_assignment -name VIRTUAL_PIN ON -to imem_addr[1]
