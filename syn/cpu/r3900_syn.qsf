# Synthesis-only project for the CPU on its own, to get area and Fmax
# before it is wired into a board. The DE10-Nano part, MiSTer's.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY r3900
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cpu/r3900.sv
set_global_assignment -name SDC_FILE r3900_syn.sdc

# Everything but the clock and reset is virtual: this project exists to
# measure the core's area and Fmax, not to bond it to a package.
set_instance_assignment -name VIRTUAL_PIN ON -to ibus_addr[0]
