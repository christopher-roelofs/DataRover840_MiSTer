#!/bin/sh
#
# Put the built core and the ROMs on the MiSTer and ask it to run one.
#
#   scripts/deploy [host] [USA|Japan|SDK]
#
# The core goes to /media/fat/_Console, which is where the menu looks. Each
# ROM is a different machine -- a RAM image belongs to the ROM that made it
# -- so each gets its own .mgl, which loads the ROM and mounts its image
# together, and the menu shows three entries for one core.
set -e
cd "$(dirname "$0")/.."

HOST=${1:-192.168.86.171}
WHICH=${2:-USA}
PASS=${MISTER_PASS:-1}
RBF=output_files/DataRover840.rbf
ROMDIR=${ROMDIR:-../magicrecomp/roms}

[ -f "$RBF" ] || { echo "deploy: no $RBF -- build it first" >&2; exit 1; }

DEST=/media/fat/_Console
NAME=DataRover840_$(date +%Y%m%d).rbf
SSH="sshpass -p $PASS ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@$HOST"
SCP="sshpass -p $PASS scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
# The games folder where Main will look for it: a USB drive's
# games/DataRover840 comes before the SD card's, as in Main's own search.
GAMES=$($SSH 'for n in 0 1 2 3 4 5; do d=/media/usb$n/games/DataRover840; \
              [ -d "$d" ] && { echo "$d"; exit; }; done; echo /media/fat/games/DataRover840')
echo "deploy: games folder $GAMES"

echo "deploy: $RBF -> $HOST:$DEST/$NAME"
$SCP "$RBF" "root@$HOST:$DEST/$NAME"
# The menu picks the newest of a dated name, so the older ones only take up
# the card.
$SSH "mkdir -p $GAMES; ls $DEST/DataRover840_*.rbf 2>/dev/null | grep -v $NAME | xargs -r rm -f; \
      [ -f $GAMES/DataRover840.sav ] && [ ! -f $GAMES/DataRover840-USA.sav ] && mv $GAMES/DataRover840.sav $GAMES/DataRover840-USA.sav; true"

# Named .rom rather than .image: MiSTer parses the core's extension filter
# in three-character chunks, so anything longer matches nothing and the file
# browser comes up empty. One .mgl per ROM.
put() {   # put <image path> <name>
    [ -f "$1" ] || { echo "deploy: no $2 ROM at $1 (skipped)"; return 0; }
    $SCP "$1" "root@$HOST:$GAMES/DataRover-840-$2.rom"
    # The RAM image is the framework's: saves/DataRover840/<rom>.sav,
    # mounted with the ROM and made by the first save. One made the old way
    # moves there, once.
    $SSH "mkdir -p /media/fat/saves/DataRover840; \
          [ -f $GAMES/DataRover840-$2.sav ] && [ ! -f /media/fat/saves/DataRover840/DataRover-840-$2.sav ] && \
              mv $GAMES/DataRover840-$2.sav /media/fat/saves/DataRover840/DataRover-840-$2.sav; \
          printf '%s\n' '<mistergamedescription>' '<rbf>_Console/DataRover840</rbf>' \
              '<file delay=\"1\" type=\"f\" index=\"1\" path=\"DataRover-840-$2.rom\"/>' \
              '</mistergamedescription>' > '$DEST/DataRover 840 ($2).mgl'"
}
put "$ROMDIR/Data Rover 840/DataRover-840-USA.image"   USA
put "$ROMDIR/Data Rover 840/DataRover-840-Japan.image" Japan
put "$ROMDIR/Rosemary SDK/MagicCap-USA.image"          SDK
$SSH "rm -f $DEST/DataRover840.mgl $GAMES/DataRover-840-USA.ima $GAMES/DataRover-840-USA.image"

# The packages the reference emulator ships, for the OSD's "Install
# package": three megabytes, in their own directory.
if ls "$ROMDIR"/../packages/*.pkg >/dev/null 2>&1; then
    $SSH "mkdir -p $GAMES/packages"
    $SCP "$ROMDIR"/../packages/*.pkg "$ROMDIR"/../packages/*.mc2 "root@$HOST:$GAMES/packages/"
fi

# The network card's cable: a daemon for the MiSTer's Linux (scripts/drnet).
$SSH "mkdir -p /media/fat/linux"
$SCP scripts/drnet "root@$HOST:/media/fat/linux/drnet"
# Updated, but not switched on: whether the daemon runs (or a Main with the
# bridge built in does the work) is the MiSTer's owner's choice, made with
# "DataRover Network.sh". A daemon already running is restarted on the new
# copy.
$SSH "chmod +x /media/fat/linux/drnet; \
      if [ -f /tmp/drnet.pid ] && kill -0 \$(cat /tmp/drnet.pid) 2>/dev/null; then \
          /media/fat/linux/drnet --stop >/dev/null 2>&1; sleep 1; \
          (setsid /media/fat/linux/drnet </dev/null >/dev/null 2>&1 &); fi"

# The LCD grid, as a shadow mask for the framework's video settings.
$SSH "mkdir -p /media/fat/Shadow_Masks"
$SCP shadow_masks/*.txt "root@$HOST:/media/fat/Shadow_Masks/"

echo "deploy: loading the $WHICH machine"
$SSH "echo load_core '$DEST/DataRover 840 ($WHICH).mgl' > /dev/MiSTer_cmd" || \
    echo "deploy: could not ask MiSTer to load it; pick it from the menu"

echo "deploy: done. scripts/serial shows what the monitor says."
