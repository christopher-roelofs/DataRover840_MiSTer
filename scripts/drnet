#!/usr/bin/env python3
#
# drnet -- the DataRover's network cable, on the MiSTer.
#
# The core's network card (an NE2000 in slot 1; OSD: Card slots) puts the frames
# it sends into a ring in the DDR memory the FPGA shares with Linux, and
# takes the frames it receives from another (rtl/dr840_netbridge.sv has the
# layout). This moves them between those rings and a TAP interface, and
# routes the DataRover's address onto the MiSTer's network:
#
#   - the MiSTer's kernel has no NAT, so the DataRover has an address of its
#     own on the local network -- one nothing else uses, typed into Magic
#     Cap's connection setup (Internet Center > Setup > the Ne2000 LAN
#     connection), with the router's address for DNS;
#   - proxy ARP answers for it on the MiSTer's network interface, and for
#     everything else on the TAP, so the router and the DataRover each send
#     their frames to the MiSTer, which forwards them. The DataRover's
#     address is learnt from its own ARP, so nothing here needs setting.
#
#   drnet            run (in the foreground; `drnet &` to leave it)
#   drnet --stop     stop a running one
#
# A MiSTer main binary with the bridge built in (support/datarover in the
# DataRover's Main_MiSTer branch) does the same work with no daemon: use
# one or the other, not both.
#
# scripts/deploy copies it to /media/fat/linux/drnet and starts it from
# /media/fat/linux/user-startup.sh, so it is always there. It does nothing
# while any other core is loaded -- the DDR it uses is theirs then -- and
# when the DataRover core starts it answers the core's hello (0x28 -> 0x30)
# with both queues emptied, so nothing is carried over from before.
import fcntl, mmap, os, select, signal, struct, subprocess, sys, time

BASE, SIZE = 0x38000000, 0x11000
MAGIC = b"DRNE"
TX_RING, RX_RING, SLOT, SLOTS = 0x1000, 0x9000, 0x800, 16
TAP = "drnet0"
TAP_MAC = "02:44:52:4e:45:30"  # fixed, and Main's too: a DataRover resumed from a
                               # saved context still has it in its ARP cache
PIDFILE = "/tmp/drnet.pid"
DEBUG = "--debug" in sys.argv

def sh(cmd):
    subprocess.run(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def uplink():
    # The interface the default route leaves by: wlan0 or eth0.
    out = subprocess.run("ip route show default", shell=True, capture_output=True, text=True).stdout.split()
    return out[out.index("dev") + 1] if "dev" in out else "eth0"

def corename():
    try:
        return open("/tmp/CORENAME").read().strip()
    except OSError:
        return ""

def main():
    if "--stop" in sys.argv:
        try:
            os.kill(int(open(PIDFILE).read()), signal.SIGTERM)
        except Exception:
            print("drnet: not running")
        return
    open(PIDFILE, "w").write(str(os.getpid()))

    fd = os.open("/dev/mem", os.O_RDWR | os.O_SYNC)
    m = mmap.mmap(fd, SIZE, mmap.MAP_SHARED, mmap.PROT_READ | mmap.PROT_WRITE, offset=BASE)
    u32 = lambda off: struct.unpack_from("<I", m, off)[0]
    def put32(off, v): struct.pack_into("<I", m, off, v & 0xFFFFFFFF)

    # The TAP: whole Ethernet frames, no packet-info header.
    tap = os.open("/dev/net/tun", os.O_RDWR)
    fcntl.ioctl(tap, 0x400454CA, struct.pack("16sH", TAP.encode(), 0x0002 | 0x1000))  # TUNSETIFF, IFF_TAP|IFF_NO_PI
    up = uplink()
    sh("ip link set %s address %s" % (TAP, TAP_MAC))
    sh("ip link set %s up" % TAP)
    sh("echo 1 > /proc/sys/net/ipv4/ip_forward")
    sh("echo 1 > /proc/sys/net/ipv4/conf/%s/proxy_arp" % TAP)
    sh("echo 1 > /proc/sys/net/ipv4/conf/%s/proxy_arp" % up)
    print("drnet: ready, %s <-> %s; waiting for the DataRover core" % (TAP, up), flush=True)

    ours = False            # the DataRover core is loaded: the DDR is its
    echo = None             # the core's hello we have answered
    def stop(*_):
        # The DDR is only ever touched while it is the DataRover's.
        if corename() == "DataRover840": m[0:4] = b"\0\0\0\0"
        try: os.unlink(PIDFILE)
        except OSError: pass
        sys.exit(0)
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    guest = None
    rx_head = tx_tail = 0
    while True:
        # Every pass: the moment another core is loaded the DDR is its.
        ours = corename() == "DataRover840"
        if not ours:
            echo = None
            time.sleep(0.25)
            continue
        # A core that has just started says hello with a new number: both
        # queues begin again from nothing, and then it is answered.
        hello = u32(0x28)
        if hello != echo:
            # Take up the core's own counters: whatever it has published is
            # what it will go on from, and anything still queued is stale.
            tx_tail = u32(0x08); rx_head = u32(0x20)
            put32(0x10, tx_tail); put32(0x18, rx_head)
            m[0:4] = MAGIC
            put32(0x30, hello)
            echo = hello
            print("drnet: the DataRover is up (hello %d)" % hello, flush=True)

        # From the DataRover: every frame it has published.
        tx_head = u32(0x08)
        while tx_tail != tx_head:
            slot = TX_RING + (tx_tail % SLOTS) * SLOT
            n = struct.unpack_from("<H", m, slot)[0]
            if 14 <= n <= 1518:
                frame = m[slot + 8:slot + 8 + n]
                # Its ARP, or the source of its IPv4, names its address:
                # route that to the TAP.
                ip = None
                if frame[12:14] == b"\x08\x06" and len(frame) >= 32: ip = frame[28:32]
                elif frame[12:14] == b"\x08\x00" and len(frame) >= 34: ip = frame[26:30]
                if ip and ip not in (b"\0\0\0\0", b"\xff\xff\xff\xff"):
                    ip = ".".join(str(b) for b in ip)
                    if ip != guest:
                        guest = ip
                        sh("ip route replace %s/32 dev %s" % (ip, TAP))
                        print("drnet: the DataRover is %s" % ip, flush=True)
                if DEBUG: print("drnet: out %s" % frame[:60].hex(), flush=True)
                try: os.write(tap, frame)
                except OSError: pass
            tx_tail = (tx_tail + 1) & 0xFFFFFFFF
            put32(0x10, tx_tail)

        # To it: whatever the TAP has, while the ring has room.
        r, _, _ = select.select([tap], [], [], 0.002)
        while r and ((rx_head - u32(0x20)) & 0xFFFFFFFF) < SLOTS:
            frame = os.read(tap, 2048)
            if DEBUG: print("drnet: in  %s" % frame[:60].hex(), flush=True)
            if 14 <= len(frame) <= 1518:
                slot = RX_RING + (rx_head % SLOTS) * SLOT
                m[slot + 8:slot + 8 + len(frame)] = frame
                struct.pack_into("<H", m, slot, len(frame))
                rx_head = (rx_head + 1) & 0xFFFFFFFF
                put32(0x18, rx_head)
            r, _, _ = select.select([tap], [], [], 0)

if __name__ == "__main__":
    main()
