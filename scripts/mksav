#!/bin/sh
#
# An empty RAM image: four megabytes of nothing, which the loader reads in
# as a clean machine. What Magic Cap does with it is written back when the
# machine is turned off.
#
#   scripts/mksav [path]
set -e
OUT=${1:-DataRover840.sav}
dd if=/dev/zero of="$OUT" bs=1M count=4 status=none
echo "mksav: $OUT (4 MiB, blank)"
